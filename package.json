{
  "name": "ai-cli-hub",
  "version": "0.1.0",
  "description": "Unified GUI for AI CLIs (Kimi Code CLI, Claude Code, Gemini CLI, Codex CLI)",
  "main": "dist-electron/main.cjs",
  "author": "ai-cli-hub",
  "license": "MIT",
  "scripts": {
    "dev": "npm run build:electron && concurrently -k \"vite\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "tsc --noEmit && vite build && npm run build:electron",
    "build:renderer": "tsc --noEmit && vite build",
    "build:electron": "esbuild electron/main.ts electron/preload.ts --bundle --platform=node --format=cjs --external:electron --external:ws --outdir=dist-electron --out-extension:.js=.cjs",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@types/js-yaml": "^4.0.9",
    "diff": "^9.0.0",
    "electron-store": "^11.0.2",
    "highlight.js": "^11.11.1",
    "iconv-lite": "^0.7.3",
    "js-yaml": "^5.2.2",
    "lucide-react": "^1.27.0",
    "monaco-editor": "^0.56.0",
    "playwright-core": "^1.62.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "smol-toml": "^1.7.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/iconv-lite": "^0.0.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "i18next": "^26.3.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "wait-on": "^9.1.0",
    "zustand": "^5.0.14"
  }
}
